# ============================================================
# Dummy Dreams Discord Bot — Environment Template
# Copy this file to `.env` (local) or set these in your hosting
# dashboard. NEVER commit real secrets.
# ============================================================

# --- Discord -------------------------------------------------
# Token from Discord Developer Portal. Use a DIFFERENT bot/token
# for test and stable.
DISCORD_TOKEN=

# Fallback announcement channel (optional; the admin panel
# setting `announcement_channel_ids` is preferred).
ANNOUNCEMENT_CHANNEL_ID=

# Fallback verified role (optional; the admin panel setting
# `verified_role_id` is preferred).
VERIFIED_ROLE_ID=

# --- Environment identity ------------------------------------
# stable | test  (default: stable)
BOT_ENV=stable

# Alias for BOT_ENV (BOT_ENV wins if both are set).
APP_ENV=

# Optional safety guard: warn in logs if the bot is not connected
# to this guild. Helps prevent test accidentally writing to prod.
EXPECTED_GUILD_ID=

# --- Web server (admin panel / API) --------------------------
# Render/Replit usually provide PORT automatically.
PORT=8080

# Optional HTTP Basic Auth for /admin routes (strongly recommended
# for any publicly reachable deployment).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional shared secret for the /api/announcement endpoint, used when
# a second instance triggers announcements. Leave empty to disable the
# check (only for trusted/private networks).
API_SECRET_KEY=

# --- Database (Turso / libSQL) -------------------------------
# Use SEPARATE databases for test and stable.
# Leave unset to use the local SQLite file (development only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite filename when TURSO_DATABASE_URL is unset.
LOCAL_DB_PATH=database.db

# --- TikTok live observer ------------------------------------
# Optional signing API key for TikTokLive (if your provider needs it).
# Either variable name works.
SIGN_API_KEY=
TIKTOK_SIGN_API_KEY=

# --- Debug / version -----------------------------------------
# Shows "DEBUG <code>" in the bot presence and enables extra logs.
DEBUG_MODE=0

# Optional short version/push code shown in debug presence.
# Falls back to BOT_VERSION or the short git commit.
PUSH_CODE=
BOT_VERSION=
